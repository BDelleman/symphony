# Symphony startup environment variables
# Copy to .env and fill values for your local setup.

# Required for live tracker mode (non-offline) when tracker.kind=linear:
LINEAR_API_KEY=
LINEAR_PROJECT_SLUG=

# Required for live tracker mode (non-offline) when tracker.kind=github:
GITHUB_TOKEN=

# Optional startup behavior:
SYMPHONY_OFFLINE=0
SYMPHONY_PORT=3000
SYMPHONY_WORKFLOW_PATH=./WORKFLOW.md

# Agent runtime selection. Codex is the default; Claude CLI is opt-in.
SYMPHONY_AGENT_RUNTIME=codex

# Required only when SYMPHONY_AGENT_RUNTIME=claude-cli. Use a full pinned
# model ID rather than a mutable alias such as "sonnet".
ANTHROPIC_MODEL=

# Optional Claude CLI executable override. Use one executable name or an
# absolute path; do not include flags.
# SYMPHONY_CLAUDE_COMMAND=/opt/homebrew/bin/claude

# Leave disabled for Team/Enterprise subscription authentication. Enabling
# this permits API keys, gateways, Bedrock, Vertex, or Foundry routing.
SYMPHONY_CLAUDE_ALLOW_NON_SUBSCRIPTION_AUTH=false

# Optional exact outbound hosts. Loopback is always rejected so the agent
# cannot reach Symphony's local operator/control API.
# SYMPHONY_CLAUDE_NETWORK_ALLOWED_DOMAINS=github.com,api.github.com,mcp.linear.app,registry.npmjs.org

# Optional exact user-scoped MCP server allowlist. linear-server is the
# required/default entry; connected servers outside this list fail readiness.
# SYMPHONY_CLAUDE_ALLOWED_MCP_SERVERS=linear-server

# Optional Codex runtime settings. These apply when the selected runtime is
# Codex and keep machine/account-specific values out of WORKFLOW.md.
# - Switch account/credits by changing SYMPHONY_CODEX_HOME
# - Keep these local in .env/.env.local (do not commit secrets)
SYMPHONY_CODEX_HOME=
SYMPHONY_CODEX_MODEL=
SYMPHONY_CODEX_REASONING=
SYMPHONY_CODEX_FLAGS=

# In tutorials, switch tracker mode by updating WORKFLOW.md tracker.kind
# and setting the matching token above.

# Optional custom env-file path override (advanced):
# SYMPHONY_ENV_FILE=./.env
